---
import '../styles/global.css';

export interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes, minimum-scale=1.0, maximum-scale=2.0" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="description" content="Herramienta de proyección de inversiones que permite simular y visualizar el crecimiento de tus inversiones en el tiempo" />
		<title>{title}</title>
		
		<!-- Merriweather font -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Merriweather:ital,opsz,wght@0,18..144,300..900;1,18..144,300..900&display=swap" rel="stylesheet">
		
		<link rel="icon" href="/piggy.svg" type="image/svg+xml" />
	</head>
	<body class="bg-bg-100 text-text-100 font-merriweather min-h-screen tracking-tight dark">
		<div class="app-container">
			<slot />
		</div>
	</body>
</html>

<style is:global>
	/* Global styles */
	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}	.app-container {
		max-width: 1200px;
		margin: 0 auto;
		padding: theme('spacing.standard');
	}
	
	/* Base component styles */	.card {
		background-color: theme('colors.bg.000');
		border: 0.5px solid theme('colors.border.300');
		border-radius: 1rem;
		overflow: hidden;
		transition: all 0.2s ease;
		margin-bottom: 1.5rem;
		box-shadow: 0 0.25rem 1.25rem rgb(0 0 0 / 7%);
	}
	
	.card:hover {
		border-color: theme('colors.border.200');
		box-shadow: 0 0.25rem 1.25rem rgb(0 0 0 / 15%);
	}
	
	.flex-between {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}
	
	.flex {
		display: flex;
		align-items: center;
	}
	
	/* Make sure SVGs inherit their parent text color */
	svg {
		fill: currentColor;
	}
</style>
