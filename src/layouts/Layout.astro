---
import '../styles/global.css';

export interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="color-scheme" content="dark" />
		<meta name="referrer" content="same-origin" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="description" content="Herramienta de proyección de inversiones que permite simular y visualizar el crecimiento de tus inversiones en el tiempo" />
		<title>{title}</title>
		
		<!-- Product UI font -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
		
		<link rel="icon" href="/piggy.svg" type="image/svg+xml" />
	</head>
	<body class="app-surface">
		<div class="app-container">
			<slot />
		</div>
	</body>
</html>

<style is:global>
	.app-container {
		width: min(100%, 1240px);
		margin: 0 auto;
		padding: 1rem;
	}

	@media (min-width: 768px) {
		.app-container {
			padding: 1.25rem;
		}
	}
</style>
