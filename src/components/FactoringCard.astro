---
import IconSVG from './IconSVG.astro';
import { getFactoringMetrics } from '../lib/dataService';
import { EXPOSE_PRIVATE_PORTFOLIO_DATA } from '../lib/config';

const { contracts } = EXPOSE_PRIVATE_PORTFOLIO_DATA ? await getFactoringMetrics() : { contracts: [] };
---

<section class="investment-card card">
  <div class="card-header flex-between">
    <div class="header-left flex-center">
      <span class="svg-icon text-accent-main-000">
        <IconSVG name="document" />
      </span>
      <h4 class="text-text-100">Factoring</h4>
    </div>
    <div class="header-right text-sm font-medium text-text-300" id="factoring-contracts-count">
      <span id="factoring-header-info"></span>
    </div>
  </div>

  {EXPOSE_PRIVATE_PORTFOLIO_DATA ? (
    <>
      <div class="tabs-container">
        <button class="tab active" data-tab="pending">Pendientes</button>
        <button class="tab" data-tab="paid">Pagados</button>
        <button class="tab" data-tab="potential-earnings">Ganancias</button>
      </div>

      <div class="search-container">
        <input type="text" id="search-contracts" placeholder="Buscar contratos..." class="search-input">
        <button id="clear-search" class="clear-search-btn" title="Limpiar búsqueda">&times;</button>
      </div>

      <div class="card-details">
        <table class="details-table">
          <thead>
            <tr>
              <th>Cliente</th>
              <th>Fecha Pago</th>
              <th>Ganancia</th>
            </tr>
          </thead>
          <tbody id="factoring-details">
            <tr class="waiting-state-row">
              <td colspan="3">
                <div class="empty-state waiting-message">
                  <span class="svg-icon">
                    <IconSVG name="touch" />
                  </span>
                  <p class="primary-text">Selecciona una categoría</p>
                  <p class="secondary-text">Haz clic en una de las pestañas superiores para ver los contratos</p>
                </div>
              </td>
            </tr>
          </tbody>
        </table>
        <div class="pagination hidden" id="pagination">
          <button id="prev-page" class="page-btn">&lt;</button>
          <span id="page-info"></span>
          <button id="next-page" class="page-btn">&gt;</button>
        </div>
      </div>
    </>
  ) : (
    <div class="privacy-state">
      <span class="svg-icon text-accent-main-000">
        <IconSVG name="warning" />
      </span>
      <p class="primary-text">Contratos privados ocultos</p>
      <p class="secondary-text">
        El build de producción no serializa contratos. Define PUBLIC_EXPOSE_PORTFOLIO_DATA=true solo para un despliegue privado.
      </p>
    </div>
  )}
</section>

{EXPOSE_PRIVATE_PORTFOLIO_DATA && (
  <>
    <script is:inline id="factoring-data" type="application/json" set:html={JSON.stringify(contracts)} />
    <script src="../scripts/factoring.ts"></script>
  </>
)}

<style is:global>
  .investment-card {
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    box-sizing: border-box;
  }

  .investment-card .tabs-container {
    min-height: 2.5rem;
    display: flex;
    flex-wrap: nowrap;
    border-bottom: 0.5px solid theme('colors.border.300');
  }

  .investment-card .tab {
    padding: 0.5rem 0.75rem;
    white-space: nowrap;
    flex: 1;
    text-align: center;
    background: transparent;
    border: none;
    cursor: pointer;
    color: theme('colors.text.300');
    transition: all 0.2s ease;
    font-size: 0.875rem;
  }

  .investment-card .tab:hover,
  .investment-card .tab.active {
    color: theme('colors.text.100');
    background-color: theme('colors.bg.300');
  }

  .investment-card .search-container {
    padding: theme('spacing.compact');
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border-bottom: 0.5px solid theme('colors.border.300');
  }

  .investment-card .search-input {
    flex: 1;
    min-width: 0;
    padding: 0.5rem 0.75rem;
    border-radius: 0.5rem;
    border: 0.5px solid theme('colors.border.300');
    background-color: theme('colors.bg.200');
    color: theme('colors.text.100');
    font-size: 0.875rem;
    box-sizing: border-box;
  }

  .investment-card .search-input:focus {
    outline: 2px solid theme('colors.accent-main.100');
    outline-offset: 2px;
    border-color: theme('colors.border.200');
  }

  .investment-card .clear-search-btn {
    width: 2rem;
    height: 2rem;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: theme('colors.bg.300');
    border: 0.5px solid theme('colors.border.300');
    border-radius: 0.5rem;
    color: theme('colors.text.300');
    font-size: 1.25rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .investment-card .clear-search-btn:hover {
    background-color: theme('colors.bg.400');
    color: theme('colors.text.100');
  }

  .investment-card .card-details {
    padding: 0;
    overflow: hidden;
    width: 100%;
  }

  .investment-card .details-table {
    width: 100%;
    min-width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
    --col-cliente: 60%;
    --col-fecha: 20%;
    --col-ganancia: 20%;
  }

  .investment-card .details-table tr:nth-child(even) {
    background-color: theme('colors.bg.200');
  }

  .investment-card .details-table th:nth-child(1),
  .investment-card .details-table td:nth-child(1) {
    width: var(--col-cliente);
    min-width: 120px;
  }

  .investment-card .details-table th:nth-child(2),
  .investment-card .details-table td:nth-child(2) {
    width: var(--col-fecha);
    min-width: 100px;
  }

  .investment-card .details-table th:nth-child(3),
  .investment-card .details-table td:nth-child(3) {
    width: var(--col-ganancia);
    min-width: 100px;
  }

  .investment-card .details-table th {
    padding: 0.75rem theme('spacing.standard');
    text-align: left;
    color: theme('colors.text.300');
    font-size: 0.875rem;
    font-weight: 500;
    border-bottom: 0.5px solid theme('colors.border.300');
  }

  .investment-card .details-table th:nth-child(2) {
    text-align: center;
  }
  .investment-card .details-table th:nth-child(3) {
    text-align: right;
  }

  .investment-card .details-table td {
    padding: 0.75rem theme('spacing.standard');
    text-align: left;
    border-bottom: 0.5px solid theme('colors.border.300');
    word-wrap: break-word;
    overflow-wrap: break-word;
  }

  .investment-card .details-table td:nth-child(2) {
    text-align: center;
  }
  .investment-card .details-table td:nth-child(3) {
    text-align: right;
  }

  .investment-card .client-name {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .investment-card .waiting-state-row td {
    padding: 2rem 1rem;
  }

  .investment-card .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 1.5rem 0;
    min-height: 120px;
  }

  .investment-card .empty-state .svg-icon {
    height: 3rem;
    width: 3rem;
    margin-bottom: 1rem;
    color: theme('colors.text.300');
  }

  .investment-card .primary-text {
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: theme('colors.text.200');
  }

  .investment-card .secondary-text {
    font-size: 0.875rem;
    color: theme('colors.text.300');
  }

  .investment-card .privacy-state {
    min-height: 11rem;
    padding: theme('spacing.standard');
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 0.5rem;
  }

  .investment-card.card {
    margin-bottom: 0;
  }

  .investment-card .pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: theme('spacing.standard');
    border-top: 0.5px solid theme('colors.border.300');
  }

  .investment-card .page-btn {
    padding: 0.25rem 0.5rem;
    border: 0.5px solid theme('colors.border.300');
    background-color: theme('colors.bg.300');
    color: theme('colors.text.100');
    border-radius: 0.25rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .investment-card .page-btn:hover:not(:disabled) {
    background-color: theme('colors.bg.400');
  }
  .investment-card .page-btn:disabled {
    opacity: 0.5;
    cursor: default;
  }

  @media (max-width: 640px) {
    .investment-card .header-right {
      text-align: right;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      min-width: 0;
    }

    .investment-card .search-container {
      padding: theme('spacing.compact');
    }

    .investment-card .search-input {
      font-size: 1rem;
    }

    .investment-card .tab {
      padding: 0.5rem 0.25rem;
      font-size: 0.8rem;
    }

    .investment-card .details-table th,
    .investment-card .details-table td {
      padding: 0.5rem theme('spacing.compact');
      font-size: 0.875rem;
    }

    .investment-card .details-table th:nth-child(1),
    .investment-card .details-table td:nth-child(1) {
      width: 40%;
      min-width: 90px;
    }

    .investment-card .details-table th:nth-child(2),
    .investment-card .details-table td:nth-child(2) {
      width: 20%;
      min-width: 70px;
    }

    .investment-card .details-table th:nth-child(3),
    .investment-card .details-table td:nth-child(3) {
      width: 20%;
      min-width: 70px;
      font-size: 0.8rem;
    }

    .investment-card .empty-state {
      padding: 1rem 0;
      min-height: 100px;
    }

    .investment-card .empty-state .svg-icon {
      height: 2.5rem;
      width: 2.5rem;
      margin-bottom: 0.75rem;
    }

    .investment-card .primary-text {
      font-size: 0.9rem;
    }

    .investment-card .secondary-text {
      font-size: 0.8rem;
    }

    .investment-card .pagination {
      padding: theme('spacing.compact');
      gap: 0.5rem;
    }

    .investment-card .page-btn {
      padding: 0.5rem 0.75rem;
      font-size: 0.875rem;
    }
  }

  @media (max-width: 480px) {
    .investment-card .header-right {
      text-align: right;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      min-width: 0;
      font-size: 0.75rem;
    }

    .investment-card .tab {
      padding: 0.5rem 0.2rem;
      font-size: 0.75rem;
    }

    .investment-card .details-table th,
    .investment-card .details-table td {
      padding: 0.4rem theme('spacing.compact');
      font-size: 0.8rem;
    }

    .investment-card .details-table th:nth-child(2),
    .investment-card .details-table td:nth-child(2),
    .investment-card .details-table th:nth-child(3),
    .investment-card .details-table td:nth-child(3) {
      font-size: 0.75rem;
    }
  }
</style>
