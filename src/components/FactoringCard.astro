---
import IconSVG from './IconSVG.astro';
import { getFactoringMetrics, type FactoringContract } from '../lib/dataService';

const { contracts } = getFactoringMetrics();
---

<section class="investment-card card">  <div class="card-header flex-between">
    <div class="header-left flex-center">
      <span class="svg-icon text-accent-main-000">
        <IconSVG name="document" />
      </span>
      <h4 class="text-text-100">Factoring</h4>
    </div>
    <div class="header-right text-sm font-medium text-text-300" id="factoring-contracts-count">
      <span id="factoring-header-info"></span>
    </div>
  </div>
  
  <div class="tabs-container">
    <button class="tab active" data-tab="pending">Pendientes</button>
    <button class="tab" data-tab="paid">Pagados</button>
    <button class="tab" data-tab="all">Todos</button>
    <button class="tab" data-tab="potential-earnings">Ganancias</button>
  </div>
  
  <div class="search-container">
    <input type="text" id="search-contracts" placeholder="Buscar contratos..." class="search-input">
    <button id="clear-search" class="clear-search-btn" title="Limpiar búsqueda">&times;</button>
  </div>
  
  <div class="card-details">
    <table class="details-table">
      <thead>
        <tr>
          <th>Cliente</th>
          <th>Fecha Pago</th>
          <th>Ganancia</th>
        </tr>
      </thead>
      <tbody id="factoring-details">
        <tr class="waiting-state-row">
          <td colspan="3">
            <div class="empty-state waiting-message">
              <span class="svg-icon">
                <IconSVG name="touch" />
              </span>
              <p class="primary-text">Selecciona una categoría</p>
              <p class="secondary-text">Haz clic en una de las pestañas superiores para ver los contratos</p>
            </div>
          </td>
        </tr>
      </tbody>
    </table>
    <div class="pagination hidden" id="pagination">
      <button id="prev-page" class="page-btn">&lt;</button>
      <span id="page-info"></span>
      <button id="next-page" class="page-btn">&gt;</button>
    </div>
  </div>
</section>

<script define:vars={{ contracts }}>
  const data = contracts;
  let currentTab = '';
  const tbody = document.getElementById('factoring-details');
  const thead = document.querySelector('.details-table thead');
  const headerInfo = document.getElementById('factoring-header-info');
  const searchInput = document.getElementById('search-contracts');
  const clearBtn = document.getElementById('clear-search');
  const tabs = Array.from(document.querySelectorAll('.tab'));
  const pagination = document.getElementById('pagination');
  const prevBtn = document.getElementById('prev-page');
  const nextBtn = document.getElementById('next-page');
  const pageInfo = document.getElementById('page-info');
  const ITEMS_PER_PAGE = 10;
  let currentPage = 1;
  let totalPages = 1;


  function formatCurrency(v) {
    return new Intl.NumberFormat('es-PE', { style: 'currency', currency: 'PEN', minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(v);
  }

  function filterContracts(tab, term) {
    const t = term.trim().toLowerCase();
    return data.filter(c => {
      if (tab === 'pending') {
        if (c.estado.toLowerCase() === 'cobrado' || c.estado.toLowerCase() === 'rechazado') return false;
      } else if (tab === 'paid') {
        if (c.estado.toLowerCase() !== 'cobrado') return false;
      } else if (tab === 'all') {
        if (c.estado.toLowerCase() === 'rechazado') return false;
      } else if (tab === 'potential-earnings') {
        if (c.estado.toLowerCase() === 'rechazado') return false;
      }
      if (!t) return true;
      return c.cliente.toLowerCase().includes(t) || c.codigo.toLowerCase().includes(t);
    });
  }

  function updateHeader(tab, list) {
    if (!headerInfo) return;
    if (tab === 'pending') {
      headerInfo.textContent = `Pendientes: ${list.length}`;
    } else if (tab === 'paid') {
      headerInfo.textContent = `Pagados: ${list.length}`;
    } else if (tab === 'all') {
      headerInfo.textContent = `Total: ${list.length}`;
    } else if (tab === 'potential-earnings') {
      const gain = list.reduce((s, c) => s + c.gainPen, 0);
      headerInfo.textContent = `Ganancias: ${formatCurrency(gain)}`;
    }
  }

  function updatePagination(list) {
    if (!pagination) return;
    totalPages = Math.max(1, Math.ceil(list.length / ITEMS_PER_PAGE));
    pageInfo.textContent = `${currentPage} / ${totalPages}`;
    prevBtn.disabled = currentPage <= 1;
    nextBtn.disabled = currentPage >= totalPages;
    pagination.classList.toggle('hidden', totalPages <= 1);
    pagination.style.display = totalPages <= 1 ? 'none' : '';
  }

  function render(tab) {
    currentTab = tab;
    tabs.forEach(tb => tb.classList.toggle('active', tb.dataset.tab === tab));
    const list = filterContracts(tab, searchInput.value || '');
    if (!tbody || !thead) return;
    updateHeader(tab, list);
    if (tab === 'potential-earnings') {
      if (pagination) {
        pagination.classList.add('hidden');
        pagination.style.display = 'none';
      }
    } else {
      updatePagination(list);
    }
    tbody.innerHTML = '';    if (tab === 'potential-earnings') {
      thead.innerHTML = '<tr><th>Estado</th><th style="text-align: right;">Contratos</th><th style="text-align: right;">Ganancia</th></tr>';
      const pending = list.filter(c => c.estado.toLowerCase() !== 'cobrado');
      const paid = list.filter(c => c.estado.toLowerCase() === 'cobrado');
      const rows = [
        { label: 'Pendientes', count: pending.length, gain: pending.reduce((s,c) => s + c.gainPen, 0) },
        { label: 'Pagados', count: paid.length, gain: paid.reduce((s,c) => s + c.gainPen, 0) },
        { label: 'Total', count: pending.length + paid.length, gain: pending.reduce((s,c) => s + c.gainPen, 0) + paid.reduce((s,c) => s + c.gainPen, 0) }
      ];
      rows.forEach(r => {
        const row = document.createElement('tr');
        row.innerHTML = `<td>${r.label}</td><td style="text-align: right;">${r.count}</td><td style="text-align: right;">${formatCurrency(r.gain)}</td>`;
        tbody.appendChild(row);
      });
      return;
    }    thead.innerHTML = '<tr><th>Cliente</th><th style="text-align: right;">Fecha Pago</th><th style="text-align: right;">Ganancia</th></tr>';
    if (list.length === 0) {
      const row = document.createElement('tr');
      row.innerHTML = `<td colspan="3"><div class="empty-state"><span class="svg-icon"><svg><use xlink:href='#icon-empty-box'></use></svg></span><p class='primary-text'>Sin contratos</p></div></td>`;
      tbody.appendChild(row);
      return;
    }
    const start = (currentPage - 1) * ITEMS_PER_PAGE;
    const paginated = list.slice(start, start + ITEMS_PER_PAGE);
    paginated.forEach(c => {
      const row = document.createElement('tr');
      row.innerHTML = `<td>${c.cliente}</td><td style="text-align: right;">${new Date(c.fechaPago).toLocaleDateString('es-PE')}</td><td style="text-align: right;">${formatCurrency(c.gainPen)}</td>`;
      tbody.appendChild(row);
    });
  }

  tabs.forEach(tb => tb.addEventListener('click', () => {
    currentPage = 1;
    render(tb.dataset.tab);
  }));
  searchInput?.addEventListener('input', () => {
    currentPage = 1;
    render(currentTab);
  });
  clearBtn?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    currentPage = 1;
    render(currentTab);
  });
  prevBtn?.addEventListener('click', () => {
    if (currentPage > 1) {
      currentPage--;
      render(currentTab);
    }
  });
  nextBtn?.addEventListener('click', () => {
    if (currentPage < totalPages) {
      currentPage++;
      render(currentTab);
    }
  });

  // Mostrar inicialmente los contratos pendientes
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => render('pending'));
  } else {
    render('pending');
  }
</script>

<style is:global>  .investment-card {
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    box-sizing: border-box;
  }
  
  .card-header {
    padding: theme('spacing.standard');
    border-bottom: 0.5px solid theme('colors.border.300');
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  
  .header-left {
    gap: 0.75rem;
  }
  
  .svg-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 1.5rem;
    width: 1.5rem;
  }
  .tabs-container {
    min-height: 2.5rem;
    display: flex;
    flex-wrap: nowrap;
    border-bottom: 0.5px solid theme('colors.border.300');
  }
  
  .tab {
    padding: 0.5rem 0.75rem;
    white-space: nowrap;
    flex: 1;
    text-align: center;
    background: transparent;
    border: none;
    cursor: pointer;
    color: theme('colors.text.300');
    transition: all 0.2s ease;
    font-size: 0.875rem;
  }
  
  .tab:hover, .tab.active {
    color: theme('colors.text.100');
    background-color: theme('colors.bg.300');
  }  .search-container {
    padding: theme('spacing.compact');
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border-bottom: 0.5px solid theme('colors.border.300');
  }
  
  .search-input {
    flex: 1;
    min-width: 0;
    padding: 0.5rem 0.75rem;
    border-radius: 0.5rem;
    border: 0.5px solid theme('colors.border.300');
    background-color: theme('colors.bg.200');
    color: theme('colors.text.100');
    font-size: 0.875rem;
    box-sizing: border-box;
  }
  
  .search-input:focus {
    outline: none;
    border-color: theme('colors.border.200');
  }
    .clear-search-btn {
    width: 2rem;
    height: 2rem;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: theme('colors.bg.300');
    border: 0.5px solid theme('colors.border.300');
    border-radius: 0.5rem;
    color: theme('colors.text.300');
    font-size: 1.25rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  
  .clear-search-btn:hover {
    background-color: theme('colors.bg.400');
    color: theme('colors.text.100');
  }
    .card-details {
    padding: 0;
    overflow: hidden;
    width: 100%;
  }
  
  .details-table {
    width: 100%;
    min-width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }
  
  .details-table th:nth-child(1),
  .details-table td:nth-child(1) {
    width: 50%;
    min-width: 120px;
  }
  
  .details-table th:nth-child(2),
  .details-table td:nth-child(2) {
    width: 25%;
    min-width: 100px;
  }
  
  .details-table th:nth-child(3),
  .details-table td:nth-child(3) {
    width: 25%;
    min-width: 100px;
  }.details-table th {
    padding: 0.75rem theme('spacing.standard');
    text-align: left;
    color: theme('colors.text.300');
    font-size: 0.875rem;
    font-weight: 500;
    border-bottom: 0.5px solid theme('colors.border.300');
  }
  
  .details-table th:nth-child(2),
  .details-table th:nth-child(3) {
    text-align: right;
  }
  
  .details-table td {
    padding: 0.75rem theme('spacing.standard');
    text-align: left;
    border-bottom: 0.5px solid theme('colors.border.300');
    word-wrap: break-word;
    overflow-wrap: break-word;
  }
  
  .details-table td:nth-child(2),
  .details-table td:nth-child(3) {
    text-align: right;
  }
  .waiting-state-row td {
    padding: 2rem 1rem;
  }
  
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 1.5rem 0;
    min-height: 120px;
  }
  
  .empty-state .svg-icon {
    height: 3rem;
    width: 3rem;
    margin-bottom: 1rem;
    color: theme('colors.text.300');
  }
  
  .primary-text {
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: theme('colors.text.200');
  }
    .secondary-text {
    font-size: 0.875rem;
    color: theme('colors.text.300');
  }
  
  /* Override the margin-bottom from the base card class to eliminate the extra space */
  .investment-card.card {
    margin-bottom: 0;
  }

  .pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: theme('spacing.standard');
    border-top: 0.5px solid theme('colors.border.300');
  }

  .page-btn {
    padding: 0.25rem 0.5rem;
    border: 0.5px solid theme('colors.border.300');
    background-color: theme('colors.bg.300');
    color: theme('colors.text.100');
    border-radius: 0.25rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .page-btn:hover:not(:disabled) {
    background-color: theme('colors.bg.400');
  }
  .page-btn:disabled {
    opacity: 0.5;
    cursor: default;
  }
  
  /* Responsive styles */
  @media (max-width: 640px) {
    .card-header {
      padding: theme('spacing.compact');
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
    
    .header-left {
      gap: 0.5rem;
    }
    
    .search-container {
      padding: theme('spacing.compact');
    }
    
    .search-input {
      font-size: 1rem; /* Evita zoom en iOS */
    }
      .tab {
      padding: 0.5rem 0.25rem;
      font-size: 0.8rem;
    }
    
    .details-table th,
    .details-table td {
      padding: 0.5rem theme('spacing.compact');
      font-size: 0.875rem;
    }
    
    .details-table th:nth-child(1),
    .details-table td:nth-child(1) {
      width: 45%;
      min-width: 100px;
    }
    
    .details-table th:nth-child(2),
    .details-table td:nth-child(2),
    .details-table th:nth-child(3),
    .details-table td:nth-child(3) {
      width: 27.5%;
      min-width: 80px;
      font-size: 0.8rem;
    }
    
    .empty-state {
      padding: 1rem 0;
      min-height: 100px;
    }
    
    .empty-state .svg-icon {
      height: 2.5rem;
      width: 2.5rem;
      margin-bottom: 0.75rem;
    }
    
    .primary-text {
      font-size: 0.9rem;
    }
    
    .secondary-text {
      font-size: 0.8rem;
    }
    
    .pagination {
      padding: theme('spacing.compact');
      gap: 0.5rem;
    }
    
    .page-btn {
      padding: 0.5rem 0.75rem;
      font-size: 0.875rem;
    }
  }
    @media (max-width: 480px) {
    .tab {
      padding: 0.5rem 0.2rem;
      font-size: 0.75rem;
    }
    
    .details-table th,
    .details-table td {
      padding: 0.4rem theme('spacing.compact');
      font-size: 0.8rem;
    }
    
    .details-table th:nth-child(2),
    .details-table td:nth-child(2),
    .details-table th:nth-child(3),
    .details-table td:nth-child(3) {
      font-size: 0.75rem;
    }
  }
</style>
