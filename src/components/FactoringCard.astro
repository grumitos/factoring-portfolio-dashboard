---
import IconSVG from './IconSVG.astro';
---

<section class="investment-card card">
  <div class="card-header flex-between">
    <div class="header-left flex">
      <span class="svg-icon text-accent-main-000">
        <IconSVG name="document" />
      </span>
      <h4 class="text-text-100">Factoring</h4>
    </div>
    <div class="header-right text-sm font-medium text-text-300" id="factoring-contracts-count">
      <span>Contando...</span>
    </div>
  </div>
  
  <div class="tabs-container">
    <button class="tab active" data-tab="pending">Pendientes</button>
    <button class="tab" data-tab="paid">Pagados</button>
    <button class="tab" data-tab="all">Todos</button>
    <button class="tab" data-tab="potential-earnings">Ganancias</button>
  </div>
  
  <div class="search-container">
    <input type="text" id="search-contracts" placeholder="Buscar contratos..." class="search-input">
    <button id="clear-search" class="clear-search-btn" title="Limpiar búsqueda">&times;</button>
  </div>
  
  <div class="card-details">
    <table class="details-table">
      <thead>
        <tr>
          <th>Cliente</th>
          <th>Fecha Pago</th>
          <th>Ganancia</th>
        </tr>
      </thead>
      <tbody id="factoring-details">
        <tr class="waiting-state-row">
          <td colspan="3">
            <div class="empty-state waiting-message">
              <span class="svg-icon">
                <IconSVG name="touch" />
              </span>
              <p class="primary-text">Selecciona una categoría</p>
              <p class="secondary-text">Haz clic en una de las pestañas superiores para ver los contratos</p>
            </div>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</section>

<style>
  .investment-card {
    width: 100%;
    overflow: hidden;
  }
  
  .card-header {
    padding: 1rem 1.5rem;
    border-bottom: 0.5px solid theme('colors.border.300');
  }
  
  .header-left {
    gap: 0.75rem;
  }
  
  .svg-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 1.5rem;
    width: 1.5rem;
  }
  
  .tabs-container {
    min-height: 2.5rem;
    display: flex;
    flex-wrap: nowrap;
    overflow-x: auto;
    overflow-y: hidden;
    justify-content: center;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    border-bottom: 0.5px solid theme('colors.border.300');
  }
  
  .tab {
    padding: 0.5rem 0.75rem;
    white-space: nowrap;
    flex: 1;
    text-align: center;
    background: transparent;
    border: none;
    cursor: pointer;
    color: theme('colors.text.300');
    transition: all 0.2s ease;
  }
  
  .tab:hover, .tab.active {
    color: theme('colors.text.100');
    background-color: theme('colors.bg.300');
  }
  
  .search-container {
    padding: 0.75rem 1rem;
    display: flex;
    border-bottom: 0.5px solid theme('colors.border.300');
  }
  
  .search-input {
    flex: 1;
    padding: 0.5rem 0.75rem;
    border-radius: 0.5rem;
    border: 0.5px solid theme('colors.border.300');
    background-color: theme('colors.bg.200');
    color: theme('colors.text.100');
    font-size: 0.875rem;
  }
  
  .search-input:focus {
    outline: none;
    border-color: theme('colors.border.200');
  }
  
  .clear-search-btn {
    margin-left: 0.5rem;
    width: 2rem;
    height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: theme('colors.bg.300');
    border: 0.5px solid theme('colors.border.300');
    border-radius: 0.5rem;
    color: theme('colors.text.300');
    font-size: 1.25rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  
  .clear-search-btn:hover {
    background-color: theme('colors.bg.400');
    color: theme('colors.text.100');
  }
  
  .card-details {
    padding: 0;
    overflow-x: auto;
  }
  
  .details-table {
    width: 100%;
    border-collapse: collapse;
  }
  
  .details-table th {
    padding: 0.75rem 1rem;
    text-align: left;
    color: theme('colors.text.300');
    font-size: 0.875rem;
    font-weight: 500;
    border-bottom: 0.5px solid theme('colors.border.300');
  }
  
  .details-table td {
    padding: 0.75rem 1rem;
    text-align: left;
    border-bottom: 0.5px solid theme('colors.border.300');
  }
  
  .waiting-state-row td {
    padding: 3rem 1rem;
  }
  
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2rem 0;
  }
  
  .empty-state .svg-icon {
    height: 3rem;
    width: 3rem;
    margin-bottom: 1rem;
    color: theme('colors.text.300');
  }
  
  .primary-text {
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: theme('colors.text.200');
  }
  
  .secondary-text {
    font-size: 0.875rem;
    color: theme('colors.text.300');
  }
</style>
