---
import IconSVG from './IconSVG.astro';
import { getFactoringMetrics } from '../lib/dataService';
import { EXPOSE_PRIVATE_PORTFOLIO_DATA } from '../lib/config';

const { contracts } = EXPOSE_PRIVATE_PORTFOLIO_DATA ? await getFactoringMetrics() : { contracts: [] };
---

<section class="investment-card card">
  <div class="card-header flex-between">
    <div class="header-left flex-center">
      <span class="svg-icon text-accent-main-000">
        <IconSVG name="document" />
      </span>
      <div>
        <h4 class="text-text-100">Factoring</h4>
      </div>
    </div>
    <div class="header-right text-sm font-medium text-text-300" id="factoring-contracts-count">
      <span id="factoring-header-info"></span>
    </div>
  </div>

  {EXPOSE_PRIVATE_PORTFOLIO_DATA ? (
    <>
      <div class="tabs-container" role="tablist" aria-label="Vista de contratos">
        <button class="tab active" data-tab="pending" role="tab" aria-selected="true" type="button">Pendientes</button>
        <button class="tab" data-tab="paid" role="tab" aria-selected="false" type="button">Pagados</button>
        <button class="tab" data-tab="potential-earnings" role="tab" aria-selected="false" type="button">Ganancias</button>
      </div>

      <div class="search-container">
        <label class="search-label" for="search-contracts">Buscar</label>
        <input type="search" id="search-contracts" placeholder="Cliente o código" class="search-input ui-input" autocomplete="off">
        <button id="clear-search" class="clear-search-btn" title="Limpiar búsqueda" aria-label="Limpiar búsqueda" type="button" disabled>&times;</button>
      </div>

      <div class="card-details">
        <table class="details-table">
          <thead>
            <tr>
              <th>Cliente</th>
              <th>Fecha Pago</th>
              <th>Ganancia</th>
            </tr>
          </thead>
          <tbody id="factoring-details">
            <tr class="waiting-state-row">
              <td colspan="3">
                <div class="empty-state waiting-message">
                  <span class="svg-icon">
                    <IconSVG name="touch" />
                  </span>
                  <p class="primary-text">Selecciona una categoría</p>
                  <p class="secondary-text">Elige una pestaña.</p>
                </div>
              </td>
            </tr>
          </tbody>
        </table>
        <div class="pagination hidden" id="pagination">
          <button id="prev-page" class="page-btn" type="button" aria-label="Página anterior">&lt;</button>
          <span id="page-info"></span>
          <button id="next-page" class="page-btn" type="button" aria-label="Página siguiente">&gt;</button>
        </div>
      </div>
    </>
  ) : (
    <div class="privacy-state">
      <span class="svg-icon text-accent-main-000">
        <IconSVG name="warning" />
      </span>
      <p class="primary-text">Contratos privados ocultos</p>
      <p class="secondary-text">
        No serializado en producción.
      </p>
    </div>
  )}
</section>

{EXPOSE_PRIVATE_PORTFOLIO_DATA && (
  <>
    <script is:inline id="factoring-data" type="application/json" set:html={JSON.stringify(contracts)} />
    <script src="../scripts/factoring.ts"></script>
  </>
)}

<style is:global>
  .investment-card {
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    box-sizing: border-box;
  }

  .investment-card .tabs-container {
    min-height: 3rem;
    display: flex;
    flex-wrap: nowrap;
    gap: 0.25rem;
    padding: 0.35rem 0.45rem 0;
    border-bottom: 1px solid theme('colors.border.300');
    background: theme('colors.bg.300');
  }

  .investment-card .tab {
    min-height: 2.4rem;
    padding: 0.45rem 0.75rem;
    white-space: nowrap;
    flex: 1;
    text-align: center;
    background: transparent;
    border: 0;
    border-bottom: 2px solid transparent;
    border-radius: 0.25rem 0.25rem 0 0;
    cursor: pointer;
    color: theme('colors.text.300');
    transition: background-color 150ms ease, border-color 150ms ease, color 150ms ease;
    font-size: 0.82rem;
    font-weight: 700;
  }

  .investment-card .tab:hover {
    color: theme('colors.text.100');
    background-color: theme('colors.accent-soft');
  }

  .investment-card .tab.active {
    color: theme('colors.text.000');
    background-color: theme('colors.accent-soft');
    border-bottom-color: theme('colors.accent-main.000');
  }

  .investment-card .search-container {
    min-height: 3.75rem;
    padding: 0.65rem 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    border-bottom: 1px solid theme('colors.border.300');
  }

  .investment-card .search-label {
    flex: 0 0 auto;
    color: theme('colors.text.300');
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .investment-card .search-input {
    flex: 1;
    min-width: 0;
    padding: 0.5rem 0.7rem;
    font-size: 0.875rem;
    box-sizing: border-box;
  }

  .investment-card .clear-search-btn {
    width: 2.25rem;
    height: 2.25rem;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: theme('colors.bg.300');
    border: 1px solid theme('colors.border.200');
    border-radius: 0.375rem;
    color: theme('colors.text.300');
    font-size: 1.25rem;
    cursor: pointer;
    transition: background-color 150ms ease, border-color 150ms ease, color 150ms ease, transform 150ms ease, opacity 150ms ease;
  }

  .investment-card .clear-search-btn:hover {
    background-color: theme('colors.bg.100');
    color: theme('colors.text.100');
  }

  .investment-card .clear-search-btn:active {
    transform: translateY(1px);
  }

  .investment-card .clear-search-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .investment-card .card-details {
    padding: 0;
    overflow: hidden;
    width: 100%;
  }

  .investment-card .details-table {
    width: 100%;
    min-width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
    --col-cliente: 60%;
    --col-fecha: 20%;
    --col-ganancia: 20%;
  }

  .investment-card .details-table tr:nth-child(even) {
    background-color: theme('colors.accent-soft');
  }

  .investment-card .details-table tbody tr {
    min-height: 3rem;
    transition: background-color 120ms ease;
  }

  .investment-card .details-table tbody tr:hover {
    background-color: theme('colors.accent-soft');
  }

  .investment-card .details-table th:nth-child(1),
  .investment-card .details-table td:nth-child(1) {
    width: var(--col-cliente);
    min-width: 120px;
  }

  .investment-card .details-table th:nth-child(2),
  .investment-card .details-table td:nth-child(2) {
    width: var(--col-fecha);
    min-width: 100px;
  }

  .investment-card .details-table th:nth-child(3),
  .investment-card .details-table td:nth-child(3) {
    width: var(--col-ganancia);
    min-width: 100px;
  }

  .investment-card .details-table th {
    position: sticky;
    top: 0;
    z-index: 1;
    padding: 0.7rem 1rem;
    text-align: left;
    color: theme('colors.text.300');
    background: theme('colors.bg.300');
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    border-bottom: 1px solid theme('colors.border.300');
  }

  .investment-card .details-table th:nth-child(2) {
    text-align: center;
  }
  .investment-card .details-table th:nth-child(3) {
    text-align: right;
  }

  .investment-card .details-table td {
    height: 3rem;
    padding: 0.62rem 1rem;
    text-align: left;
    border-bottom: 1px solid theme('colors.border.300');
    word-wrap: break-word;
    overflow-wrap: break-word;
    color: theme('colors.text.200');
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }

  .investment-card .details-table td:nth-child(2) {
    text-align: center;
  }
  .investment-card .details-table td:nth-child(3) {
    text-align: right;
  }

  .investment-card .client-name {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .investment-card .waiting-state-row td {
    padding: 1.5rem 1rem;
  }

  .investment-card .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 1.25rem 0;
    min-height: 10rem;
  }

  .investment-card .empty-state .svg-icon {
    height: 2.25rem;
    width: 2.25rem;
    margin-bottom: 0.75rem;
    color: theme('colors.text.300');
  }

  .investment-card .primary-text {
    font-weight: 600;
    margin-bottom: 0.35rem;
    color: theme('colors.text.200');
  }

  .investment-card .secondary-text {
    font-size: 0.875rem;
    color: theme('colors.text.300');
    line-height: 1.45;
  }

  .investment-card .privacy-state {
    min-height: 11rem;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 0.5rem;
  }

  .investment-card.card {
    margin-bottom: 0;
  }

  .investment-card .pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 3.5rem;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    border-top: 1px solid theme('colors.border.300');
  }

  .investment-card .page-btn {
    min-width: 2.25rem;
    min-height: 2.25rem;
    padding: 0.25rem 0.5rem;
    border: 1px solid theme('colors.border.200');
    background-color: theme('colors.bg.300');
    color: theme('colors.text.100');
    border-radius: 0.375rem;
    cursor: pointer;
    transition: background-color 150ms ease, border-color 150ms ease, transform 150ms ease, opacity 150ms ease;
  }

  .investment-card .page-btn:hover:not(:disabled) {
    background-color: theme('colors.bg.100');
    border-color: theme('colors.border.100');
  }

  .investment-card .page-btn:active:not(:disabled) {
    transform: translateY(1px);
  }
  .investment-card .page-btn:disabled {
    opacity: 0.5;
    cursor: default;
  }

  @media (max-width: 640px) {
    .investment-card .header-right {
      text-align: right;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      min-width: 0;
    }

    .investment-card .search-container {
      padding: 0.65rem;
      display: grid;
      grid-template-columns: 1fr auto;
    }

    .investment-card .search-label {
      grid-column: 1 / -1;
    }

    .investment-card .search-input {
      font-size: 1rem;
    }

    .investment-card .tab {
      padding: 0.5rem 0.25rem;
      font-size: 0.8rem;
    }

    .investment-card .details-table th,
    .investment-card .details-table td {
      padding: 0.5rem theme('spacing.compact');
      font-size: 0.875rem;
    }

    .investment-card .details-table th:nth-child(1),
    .investment-card .details-table td:nth-child(1) {
      width: 40%;
      min-width: 90px;
    }

    .investment-card .details-table th:nth-child(2),
    .investment-card .details-table td:nth-child(2) {
      width: 20%;
      min-width: 70px;
    }

    .investment-card .details-table th:nth-child(3),
    .investment-card .details-table td:nth-child(3) {
      width: 20%;
      min-width: 70px;
      font-size: 0.8rem;
    }

    .investment-card .empty-state {
      padding: 1rem 0;
      min-height: 100px;
    }

    .investment-card .empty-state .svg-icon {
      height: 2.5rem;
      width: 2.5rem;
      margin-bottom: 0.75rem;
    }

    .investment-card .primary-text {
      font-size: 0.9rem;
    }

    .investment-card .secondary-text {
      font-size: 0.8rem;
    }

    .investment-card .pagination {
      padding: theme('spacing.compact');
      gap: 0.5rem;
    }

    .investment-card .page-btn {
      padding: 0.5rem 0.75rem;
      font-size: 0.875rem;
    }
  }

  @media (max-width: 480px) {
    .investment-card .header-right {
      text-align: right;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      min-width: 0;
      font-size: 0.75rem;
    }

    .investment-card .tab {
      padding: 0.5rem 0.2rem;
      font-size: 0.75rem;
    }

    .investment-card .details-table th,
    .investment-card .details-table td {
      padding: 0.4rem theme('spacing.compact');
      font-size: 0.8rem;
    }

    .investment-card .details-table th:nth-child(2),
    .investment-card .details-table td:nth-child(2),
    .investment-card .details-table th:nth-child(3),
    .investment-card .details-table td:nth-child(3) {
      font-size: 0.75rem;
    }
  }
</style>
