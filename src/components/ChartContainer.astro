---
import IconSVG from './IconSVG.astro';
import type { PortfolioReport } from '../lib/dataService';

interface Props {
  report: PortfolioReport;
}

const { report } = Astro.props as Props;
---

<section class="chart-container card">
  <div class="card-header flex-between">
    <div class="header-left flex">
      <span class="svg-icon text-accent-main-000">
        <IconSVG name="chart" />
      </span>
      <h4 class="text-text-100">Proyección</h4>
    </div>
    <div class="header-right chart-legend-container">
      <!-- Legend will be populated by JavaScript -->
    </div>
  </div>
  <div class="goal-slider">
    <label for="goalRange" class="text-sm text-text-300">Meta:</label>
    <input
      id="goalRange"
      type="range"
      min="200000"
      max="2000000"
      step="10000"
      value="200000"
      class="flex-1"
    />
    <span id="goalValue" class="text-sm text-text-100">200000</span>
  </div>
  <div class="chart-wrapper">
    <canvas id="proyeccion-chart"></canvas>
  </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script define:vars={{ report }}>
  const ctx = document.getElementById('proyeccion-chart').getContext('2d');

  const computeData = (goal) => {
    const rMonthly = Math.pow(1 + report.annualRatePct / 100, 1 / 12) - 1;
    const injection = 6000;
    let withoutInj = report.netPen + report.netUsd * 3.7;
    let withInj = withoutInj;
    const labels = [];
    const seriesA = [];
    const seriesB = [];
    let month = 0;
    const startYear = new Date().getFullYear();
    while ((withInj < goal || month % 12 !== 0) && month < 600) {
      if (month % 12 === 0) {
        labels.push(String((startYear + month / 12)).slice(-2));
        seriesA.push(Math.round(withoutInj));
        seriesB.push(Math.round(withInj));
      }
      withoutInj *= 1 + rMonthly;
      withInj = withInj * (1 + rMonthly) + injection;
      month++;
    }
    // push last point
    labels.push(String((startYear + month / 12)).slice(-2));
    seriesA.push(Math.round(withoutInj));
    seriesB.push(Math.round(withInj));
    return { labels, seriesA, seriesB };
  };

  let { labels, seriesA, seriesB } = computeData(200000);

  const chart = new Chart(ctx, {
    type: 'line',
    data: {
      labels,
      datasets: [
        {
          label: 'Sin Inyección',
          data: seriesA,
          borderColor: '#3b82f6',
          backgroundColor: 'transparent'
        },
        {
          label: 'Con Inyección',
          data: seriesB,
          borderColor: '#16a34a',
          backgroundColor: 'transparent'
        }
      ]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      scales: {
        y: {
          ticks: {
            callback: (value) => Number(value).toLocaleString('es-PE', { maximumFractionDigits: 0 })
          }
        }
      }
    }
  });

  const range = document.getElementById('goalRange');
  const label = document.getElementById('goalValue');
  label.textContent = Number(range.value).toLocaleString('es-PE');

  range.addEventListener('input', () => {
    const goal = parseInt(range.value, 10);
    label.textContent = goal.toLocaleString('es-PE');
    const d = computeData(goal);
    chart.data.labels = d.labels;
    chart.data.datasets[0].data = d.seriesA;
    chart.data.datasets[1].data = d.seriesB;
    chart.update();
  });
</script>

<style>
  .chart-container {
    width: 100%;
    margin-bottom: 1.5rem;
  }
  .card-header {
    padding: theme('spacing.standard');
    border-bottom: 0.5px solid theme('colors.border.300');
  }
  
  .header-left {
    gap: 0.75rem;
  }
  
  .svg-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 1.5rem;
    width: 1.5rem;
  }
  .goal-slider {
    padding: 0.75rem 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .goal-slider input[type='range'] {
    flex: 1;
  }
    .chart-wrapper {
    padding: 1.5rem;
    height: 300px;
    position: relative;
  }
  
  h4 {
    font-weight: 600;
  }
</style>
