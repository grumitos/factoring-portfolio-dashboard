---
import IconSVG from './IconSVG.astro';
import type { PortfolioReport } from '../lib/dataService';
import { fetchLatestRate } from '../lib/fxService';

interface Props {
  report: PortfolioReport;
  injection: number;
}

const { report, injection } = Astro.props as Props;
let fxRate = 3.7;
try {
  fxRate = await fetchLatestRate();
} catch {
  // keep default fxRate
}
---

<section class="chart-container card">  <div class="card-header flex-between">
    <div class="header-left flex-center">
      <span class="svg-icon text-accent-main-000">
        <IconSVG name="chart" />
      </span>
      <h4 class="text-text-100">Proyección</h4>
    </div>
    <div class="header-right chart-legend-container">
      <div class="chart-legend">
        <div class="legend-item">
          <div class="legend-dot" style="background-color: #C2C0B6;"></div>
          <span class="legend-label">Sin Aportes</span>
        </div>
        <div class="legend-item">
          <div class="legend-dot" style="background-color: #C96442;"></div>
          <span class="legend-label">Con Aportes</span>
        </div>
      </div>
    </div>
  </div>
  <div class="chart-wrapper">
    <canvas id="proyeccion-chart"></canvas>
  </div>
  <div class="goal-slider">
    <label for="goalRange" class="text-sm text-text-300">Meta:</label>
    <input
      id="goalRange"
      type="range"
      min="200000"
      max="2000000"
      step="200000"
      value="200000"
      list="goalTicks"
      class="flex-1"
    />
    <datalist id="goalTicks">
      <option value="200000"></option>
      <option value="400000"></option>
      <option value="600000"></option>
      <option value="800000"></option>
      <option value="1000000"></option>
      <option value="1200000"></option>
      <option value="1400000"></option>
      <option value="1600000"></option>
      <option value="1800000"></option>
      <option value="2000000"></option>
    </datalist>
    <span id="goalValue" class="text-sm text-text-100">S/ 200,000</span>
  </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script define:vars={{ report, injection, fxRate }}>
  // Esperar a que Chart.js se cargue
  function initChart() {
    if (typeof Chart === 'undefined') {
      setTimeout(initChart, 100);
      return;
    }

    const ctx = document.getElementById('proyeccion-chart');
    if (!ctx) {
      console.error('Canvas element not found');      return;
    }

    console.log('Report data:', report); // Debug

    // Obtener los colores del tema CSS
    const styles = getComputedStyle(document.documentElement);
    const textColor100 = styles.getPropertyValue('--color-text-100').trim();
    const textColor200 = styles.getPropertyValue('--color-text-200').trim();
    const textColor300 = styles.getPropertyValue('--color-text-300').trim();
    const accentMain000 = styles.getPropertyValue('--color-accent-main-000').trim();
    const accentMain100 = styles.getPropertyValue('--color-accent-main-100').trim();
    const bgColor000 = styles.getPropertyValue('--color-bg-000').trim();

    const computeData = (goal) => {
      const rMonthly = Math.pow(1 + report.annualRatePct / 100, 1 / 12) - 1;
      let withoutInj = report.netPen + report.netUsd * fxRate;
      let withInj = withoutInj;
      const labels = [];
      const seriesA = [];
      const seriesB = [];
      let month = 0;      const startYear = new Date().getFullYear();
      
      while ((withInj < goal || month % 12 !== 0) && month < 600) {
        if (month % 12 === 0) {
          labels.push(String(startYear + month / 12));
          seriesA.push(Math.round(withoutInj));
          seriesB.push(Math.round(withInj));
        }
        withoutInj *= 1 + rMonthly;
        withInj = withInj * (1 + rMonthly) + injection;
        month++;
      }
      // push last point
      labels.push(String(startYear + month / 12));
      seriesA.push(Math.round(withoutInj));
      seriesB.push(Math.round(withInj));
      
      console.log('Chart data computed:', { labels, seriesA, seriesB }); // Debug
      return { labels, seriesA, seriesB };
    };

    let { labels, seriesA, seriesB } = computeData(200000);

    const chart = new Chart(ctx, {
      type: 'line',
      data: {
        labels,        datasets: [          {
            label: 'Sin Aportes',
            data: seriesA,
            borderColor: textColor200,
            backgroundColor: `${textColor200}1A`, // 10% opacity
            tension: 0.3,
            borderWidth: 2,
            pointBackgroundColor: textColor200,
            pointBorderColor: bgColor000,
            pointBorderWidth: 2,
            pointRadius: 4,
            pointHoverRadius: 6
          },          {
            label: 'Con Aportes',
            data: seriesB,
            borderColor: accentMain000,
            backgroundColor: `${accentMain000}1A`, // 10% opacity
            tension: 0.3,
            borderWidth: 3,
            pointBackgroundColor: accentMain000,
            pointBorderColor: bgColor000,
            pointBorderWidth: 2,
            pointRadius: 4,
            pointHoverRadius: 6
          }
        ]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,        plugins: {
          legend: {
            display: false
          },
          tooltip: {
            backgroundColor: bgColor000,
            titleColor: textColor100,
            bodyColor: textColor200,
            borderColor: textColor300,
            borderWidth: 1,
            cornerRadius: 8,
            displayColors: true,
            titleFont: {
              family: 'Merriweather',
              size: 14,
              weight: '600'
            },
            bodyFont: {
              family: 'Merriweather',
              size: 12
            },
            footerFont: {
              family: 'Merriweather',
              size: 10
            },
            footerColor: textColor300,
            callbacks: {
              title: function(tooltipItems) {
                return `${tooltipItems[0].label}`;
              },
              label: function(context) {
                const value = context.parsed.y;
                const formattedValue = new Intl.NumberFormat('es-PE', { 
                  style: 'currency', 
                  currency: 'PEN',
                  minimumFractionDigits: 0,
                  maximumFractionDigits: 0
                }).format(value);
                return `${context.dataset.label}: ${formattedValue}`;
              }
            }
          }
        },
        scales: {          x: {
                ticks: {
                  color: textColor200,
                  font: {
                    family: 'Merriweather',
                    size: 12
                  },
                  callback: function(value, index, ticks) {
                    const label = this.getLabelForValue(value);
                    return label.slice(-2);
                  }
                },
                grid: {
                  color: `${textColor200}1A`, // 10% opacity
                  borderColor: textColor200
                }
              },          y: {
            ticks: {
              color: textColor200,
              font: {
                family: 'Merriweather',
                size: 12
              },
              callback: (value) => {
                const num = Number(value);
                if (num >= 1000000) {
                  return (num / 1000000).toFixed(num % 1000000 === 0 ? 0 : 1) + 'M';
                } else if (num >= 1000) {
                  return (num / 1000).toFixed(num % 1000 === 0 ? 0 : 1) + 'K';
                }
                return num.toLocaleString('es-PE', { maximumFractionDigits: 0 });
              }
            },
            grid: {
              color: `${textColor200}1A`, // 10% opacity
              borderColor: textColor200
            }
          }
        },
        interaction: {
          intersect: false,
          mode: 'index'
        },        elements: {
          point: {
            hoverBackgroundColor: accentMain100
          }
        }
      }
    });

    // Formatear valores del slider (ej: 1M, 1.2K)
    function formatSliderValue(num) {
      if (num >= 1000000) {
        return (num / 1000000).toFixed(num % 1000000 === 0 ? 0 : 1) + 'M';
      } else if (num >= 1000) {
        return (num / 1000).toFixed(num % 1000 === 0 ? 0 : 1) + 'K';
      }
      return num.toLocaleString('es-PE', { maximumFractionDigits: 0 });
    }
    const range = document.getElementById('goalRange');
    const label = document.getElementById('goalValue');
    
    if (range && label) {
      label.textContent = `S/ ${formatSliderValue(Number(range.value))}`;

      range.addEventListener('input', () => {
        const goal = parseInt(range.value, 10);
        label.textContent = `S/ ${formatSliderValue(goal)}`;
        const d = computeData(goal);
        chart.data.labels = d.labels;
        chart.data.datasets[0].data = d.seriesA;
        chart.data.datasets[1].data = d.seriesB;
        chart.update();
      });
    }
  }

  // Inicializar cuando el DOM esté listo
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initChart);
  } else {
    initChart();
  }
</script>

<style>
  .chart-container {
    width: 100%;
    margin-bottom: theme('spacing.standard');
  }
  .card-header {
    padding: theme('spacing.standard');
    border-bottom: 0.5px solid theme('colors.border.300');
  }
  .header-left {
    gap: theme('spacing.compact');
  }
  .svg-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 1.5rem;
    width: 1.5rem;
  }
  .chart-legend {
    display: flex;
    gap: theme('spacing.standard');
    align-items: center;
  }  .legend-item {
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }
  .legend-dot {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    border: 1px solid theme('colors.bg.000');
  }
  .legend-label {
    font-size: 0.875rem;
    color: theme('colors.text.200');
    font-weight: 500;
  }  @media (max-width: 640px) {
    .card-header {
      padding: theme('spacing.compact');
      flex-wrap: nowrap;
      align-items: center;
      gap: 0.5rem;
    }
    
    .header-left {
      gap: 0.5rem;
      flex-shrink: 0;
    }
    
    .chart-legend {
      gap: theme('spacing.compact');
      flex-shrink: 0;
    }
    
    .legend-item {
      gap: 0.25rem;
    }
    
    .legend-label {
      font-size: 0.75rem;
      white-space: nowrap;
    }
    
    .legend-dot {
      width: 0.625rem;
      height: 0.625rem;
      flex-shrink: 0;
    }
  }
  
  @media (max-width: 480px) {
    .card-header {
      padding: theme('spacing.compact');
      flex-wrap: nowrap;
      align-items: center;
      gap: 0.25rem;
    }
    
    .header-left {
      gap: 0.25rem;
      flex-shrink: 0;
    }
    
    .chart-legend {
      gap: 0.25rem;
      flex-shrink: 0;
    }
    
    .legend-item {
      gap: 0.2rem;
    }
    
    .legend-label {
      font-size: 0.65rem;
      white-space: nowrap;
    }
    
    .legend-dot {
      width: 0.5rem;
      height: 0.5rem;
      flex-shrink: 0;
    }
  }
  .goal-slider {
    padding: 0.6rem theme('spacing.standard') theme('spacing.standard') theme('spacing.standard');
    display: flex;
    align-items: center;
    gap: theme('spacing.compact');
  }
  .goal-slider input[type='range'] {
    flex: 1;
    accent-color: theme('colors.border.300');
  }
  .goal-slider #goalValue {
    display: inline-block;
    text-align: right;
    width: 3.4rem;
    flex-shrink: 0;
  }
  .goal-slider label {
    width: 3.4rem;
    flex-shrink: 0;
  }
  .chart-wrapper {
    padding: theme('spacing.standard') theme('spacing.standard') 0 theme('spacing.standard');
    height: 18.75rem;
    position: relative;
  }
  .chart-wrapper canvas {
    width: 100% !important;
    height: 100% !important;
  }
  h4 {
    font-weight: 600;
  }
</style>
