---
import IconSVG from './IconSVG.astro';
import type { PortfolioReport } from '../lib/dataService';
import {
  SLIDER_MIN,
  SLIDER_MAX,
  SLIDER_STEP,
  SLIDER_INITIAL,
  GOAL
} from '../lib/config';

interface Props {
  report: PortfolioReport;
  injection: number;
  fxRate: number;
  sliderMin?: number;
  sliderMax?: number;
  sliderStep?: number;
  sliderInitial?: number;
  goalInitial?: number;
}

const {
  report,
  injection,
  fxRate,
  sliderMin = SLIDER_MIN,
  sliderMax = SLIDER_MAX,
  sliderStep = SLIDER_STEP,
  sliderInitial = SLIDER_INITIAL,
  goalInitial = GOAL
} = Astro.props as Props;
---

<section class="chart-container card">
  <div class="card-header flex-between">
    <div class="header-left flex-center">
      <span class="svg-icon text-accent-main-000">
        <IconSVG name="chart" />
      </span>
      <div>
        <h4 class="text-text-100">Proyección</h4>
      </div>
    </div>
    <div class="header-right chart-legend-container">
      <div class="chart-legend">
        <div class="legend-item">
          <div class="legend-dot" style="background-color: var(--color-text-100);"></div>
          <span class="legend-label">Sin Aportes</span>
        </div>
        <div class="legend-item">
          <div class="legend-dot" style="background-color: var(--color-accent-main-000);"></div>
          <span class="legend-label">Con Aportes</span>
        </div>
      </div>
    </div>
  </div>
  <div class="chart-wrapper">
    <canvas id="proyeccion-chart"></canvas>
  </div>
  <div class="goal-slider">
    <label for="goalRange" class="text-sm text-text-300">Meta</label>
    <input
      id="goalRange"
      type="range"
      min={sliderMin}
      max={sliderMax}
      step={sliderStep}
      value={sliderInitial}
      list="goalTicks"
      class="flex-1"
    />
    <datalist id="goalTicks">
      {Array.from({ length: Math.floor((sliderMax - sliderMin) / sliderStep) + 1 }, (_, i) => (
        <option value={sliderMin + i * sliderStep}></option>
      ))}
    </datalist>
    <span id="goalValue" class="text-sm text-text-100">S/ {sliderInitial.toLocaleString('es-PE')}</span>
  </div>
</section>

<script is:inline id="chart-data" type="application/json" set:html={JSON.stringify({
  report: { netPen: report.netPen, netUsd: report.netUsd, annualRatePct: report.annualRatePct },
  injection,
  fxRate,
  goalInitial
})} />
<script src="../scripts/chart.ts"></script>

<style>
  .chart-container {
    width: 100%;
    margin-bottom: 0;
  }

  .chart-legend {
    display: flex;
    gap: 0.55rem;
    align-items: center;
  }
  .legend-item {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 1.75rem;
    padding: 0 0.55rem;
    border: 1px solid theme('colors.border.300');
    border-radius: 999px;
    background: theme('colors.bg.400');
  }
  .legend-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    border: 1px solid theme('colors.bg.500');
  }
  .legend-label {
    font-size: 0.75rem;
    color: theme('colors.text.200');
    font-weight: 700;
  }
  @media (max-width: 640px) {
    .chart-legend {
      gap: theme('spacing.compact');
      flex-shrink: 0;
    }

    .legend-item {
      gap: 0.25rem;
    }

    .legend-label {
      font-size: 0.75rem;
      white-space: nowrap;
    }

    .legend-dot {
      width: 0.625rem;
      height: 0.625rem;
      flex-shrink: 0;
    }
  }

  @media (max-width: 480px) {
    .chart-legend {
      gap: 0.25rem;
      flex-shrink: 0;
    }

    .legend-item {
      gap: 0.2rem;
    }

    .legend-label {
      font-size: 0.65rem;
      white-space: nowrap;
    }

    .legend-dot {
      width: 0.5rem;
      height: 0.5rem;
      flex-shrink: 0;
    }
  }
  .goal-slider {
    min-height: 4rem;
    padding: 0.75rem 1rem 1rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border-top: 1px solid theme('colors.border.300');
  }
  .goal-slider input[type='range'] {
    flex: 1;
    min-width: 0;
    accent-color: theme('colors.accent-main.000');
    cursor: pointer;
  }
  .goal-slider #goalValue {
    display: inline-block;
    text-align: right;
    width: 5.5rem;
    flex-shrink: 0;
    font-variant-numeric: tabular-nums;
    font-weight: 700;
  }
  .goal-slider label {
    width: 2.5rem;
    flex-shrink: 0;
    font-weight: 700;
  }
  .chart-wrapper {
    padding: 1rem 1rem 0;
    height: clamp(18rem, 38vh, 27rem);
    position: relative;
  }
  .chart-wrapper canvas {
    width: 100% !important;
    height: 100% !important;
  }
  h4 {
    font-weight: 800;
    line-height: 1.1;
  }

  @media (max-width: 640px) {
    .goal-slider {
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: 0.55rem;
      padding: 0.75rem;
    }

    .chart-wrapper {
      height: 16rem;
      padding: 0.75rem 0.65rem 0;
    }
  }

  @media (max-width: 420px) {
    .chart-legend-container {
      width: 100%;
    }

    .chart-legend {
      width: 100%;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .legend-item {
      justify-content: center;
    }
  }
</style>
