---
import type { PortfolioReport } from '../lib/dataService';
import { formatCompact, formatPenInteger } from '../lib/format';
import {
  INJECTION_ITER_LIMIT,
  SLIDER_MIN,
  SLIDER_MAX,
  SLIDER_STEP,
  SLIDER_INITIAL,
  GOAL
} from '../lib/config';

interface Props {
  report: PortfolioReport;
  injection: number;
  fxRate: number;
  sliderMin?: number;
  sliderMax?: number;
  sliderStep?: number;
  sliderInitial?: number;
  goalInitial?: number;
}

const {
  report,
  injection,
  fxRate,
  sliderMin = SLIDER_MIN,
  sliderMax = SLIDER_MAX,
  sliderStep = SLIDER_STEP,
  sliderInitial = SLIDER_INITIAL,
  goalInitial = GOAL
} = Astro.props as Props;

const fillPct = sliderMax > sliderMin ? ((sliderInitial - sliderMin) / (sliderMax - sliderMin)) * 100 : 0;
const chartData = JSON.stringify({
  report: { netPen: report.netPen, netUsd: report.netUsd, annualRatePct: report.annualRatePct },
  injection,
  fxRate,
  goalInitial,
  maxHalfSteps: INJECTION_ITER_LIMIT
}).replace(/</g, '\\u003c');
---

<section class="panel chart-panel" aria-label="Proyección">
  <div class="chart-bar">
    <div class="chart-legend" role="group" aria-label="Series">
      <button type="button" class="legend-toggle" data-series="1" aria-pressed="true">
        <span class="swatch is-with" aria-hidden="true"></span>
        Con aportes <span class="num">{formatPenInteger(injection)}/mes</span>
      </button>
      <button type="button" class="legend-toggle" data-series="0" aria-pressed="true">
        <span class="swatch is-without" aria-hidden="true"></span>
        Sin aportes
      </button>
    </div>

    <div class="goal-slider">
      <label for="goalRange">Meta</label>
      <input
        id="goalRange"
        type="range"
        min={sliderMin}
        max={sliderMax}
        step={sliderStep}
        value={sliderInitial}
        style={`--fill: ${fillPct}%`}
      />
      <output id="goalValue" for="goalRange" class="num">S/ {formatCompact(sliderInitial)}</output>
    </div>
  </div>

  <div class="chart-wrapper">
    <canvas id="proyeccion-chart" role="img" aria-label="Proyección del patrimonio con y sin aportes"></canvas>
  </div>
</section>

<script is:inline id="chart-data" type="application/json" set:html={chartData} />
<script src="../scripts/chart.ts"></script>

<style>
  .chart-panel {
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
  }

  .chart-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem 1.5rem;
    padding: 0.5rem 1rem;
    border-bottom: 1px solid theme('colors.border.300');
  }

  .chart-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.25rem;
  }

  .legend-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0;
    border: 0;
    background: none;
    color: theme('colors.text.200');
    font-size: 0.75rem;
    cursor: pointer;
  }

  .legend-toggle .num {
    color: theme('colors.text.300');
  }

  .legend-toggle[aria-pressed='false'] {
    color: theme('colors.text.400');
  }

  .legend-toggle[aria-pressed='false'] .swatch {
    opacity: 0.3;
  }

  .swatch {
    width: 1rem;
    flex-shrink: 0;
  }

  .swatch.is-with {
    height: 2px;
    background: theme('colors.accent-main.100');
  }

  .swatch.is-without {
    border-top: 1.5px dashed theme('colors.text.300');
  }

  .goal-slider {
    display: flex;
    flex: 1 1 15rem;
    align-items: center;
    gap: 0.75rem;
    max-width: 21rem;
  }

  .goal-slider label {
    color: theme('colors.text.300');
    font-size: 0.75rem;
  }

  .goal-slider output {
    min-width: 3.75rem;
    color: theme('colors.text.000');
    font-size: 0.8125rem;
    text-align: right;
  }

  .goal-slider input[type='range'] {
    --fill: 0%;
    flex: 1;
    min-width: 0;
    height: 1.5rem;
    margin: 0;
    background: transparent;
    cursor: pointer;
    -webkit-appearance: none;
    appearance: none;
  }

  .goal-slider input[type='range']::-webkit-slider-runnable-track {
    height: 2px;
    background: linear-gradient(
      90deg,
      theme('colors.accent-main.100') var(--fill),
      theme('colors.border.200') var(--fill)
    );
  }

  .goal-slider input[type='range']::-moz-range-track {
    height: 2px;
    background: theme('colors.border.200');
  }

  .goal-slider input[type='range']::-moz-range-progress {
    height: 2px;
    background: theme('colors.accent-main.100');
  }

  .goal-slider input[type='range']::-webkit-slider-thumb {
    width: 0.75rem;
    height: 0.75rem;
    margin-top: -5px;
    border: 0;
    border-radius: 50%;
    background: theme('colors.accent-main.100');
    -webkit-appearance: none;
    appearance: none;
  }

  .goal-slider input[type='range']::-moz-range-thumb {
    width: 0.75rem;
    height: 0.75rem;
    border: 0;
    border-radius: 50%;
    background: theme('colors.accent-main.100');
  }

  .chart-wrapper {
    position: relative;
    height: 16rem;
    padding: 0.75rem 0.5rem 0.25rem 0.25rem;
  }

  .chart-wrapper canvas {
    width: 100% !important;
    height: 100% !important;
  }

  @media (min-width: 768px) {
    .chart-wrapper {
      height: 20rem;
      padding: 1rem 1rem 0.5rem 0.5rem;
    }
  }

  /* Junto a la tabla: el lienzo ocupa el alto que deja la barra */
  @media (min-width: 1100px) {
    .chart-wrapper {
      flex: 1;
      height: auto;
      min-height: 0;
    }
  }
</style>
