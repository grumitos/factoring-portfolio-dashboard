---
import IconSVG from './IconSVG.astro';
---

<section class="chart-container card">
  <div class="card-header flex-between">
    <div class="header-left flex">
      <span class="svg-icon text-accent-main-000">
        <IconSVG name="chart" />
      </span>
      <h4 class="text-text-100">Proyección</h4>
    </div>
    <div class="header-right chart-legend-container">
      <!-- Legend will be populated by JavaScript -->
    </div>
  </div>
  <div class="chart-wrapper">
    <canvas id="proyeccion-chart"></canvas>
  </div>
</section>

<style>
  .chart-container {
    width: 100%;
    margin-bottom: 1.5rem;
  }
    .card-header {
    padding: 1.5rem;
    border-bottom: 0.5px solid theme('colors.border.300');
  }
  
  .header-left {
    gap: 0.75rem;
  }
  
  .svg-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 1.5rem;
    width: 1.5rem;
  }
    .chart-wrapper {
    padding: 1.5rem;
    height: 300px;
    position: relative;
  }
  
  h4 {
    font-weight: 600;
  }
</style>
