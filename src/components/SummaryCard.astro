---
interface Props {
  label: string;
  value: string;
  /** Identificador para que un script actualice la celda (data-kpi) */
  name?: string;
  /** Etiqueta del dato secundario (texto) */
  note?: string;
  /** Dato secundario (cifra) */
  noteValue?: string;
  noteTone?: 'positive';
  /** Porcentaje 0-100; muestra una barra de avance bajo el valor */
  progress?: number;
}

const { label, value, name, note, noteValue, noteTone, progress } = Astro.props;
const progressPct = progress === undefined ? undefined : Math.min(100, Math.max(0, progress));
---

<div class="kpi" data-kpi={name}>
  <p class="kpi-label">{label}</p>
  <p class="kpi-value num">{value}</p>
  {progressPct !== undefined && (
    <div
      class="kpi-progress"
      role="progressbar"
      aria-label={label}
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow={Math.round(progressPct)}
    >
      <span style={`width: ${progressPct}%`}></span>
    </div>
  )}
  {(note || noteValue) && (
    <p class="kpi-note">
      {note && <span>{note}</span>}
      {noteValue && <span class:list={['num', noteTone && `is-${noteTone}`]}>{noteValue}</span>}
    </p>
  )}
</div>

<style>
  .kpi {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    min-width: 0;
    padding: 0.875rem 1rem;
  }

  .kpi:nth-child(even) {
    border-left: 1px solid theme('colors.border.300');
  }

  .kpi:nth-child(n + 3) {
    border-top: 1px solid theme('colors.border.300');
  }

  .kpi-label {
    color: theme('colors.text.300');
    font-size: 0.75rem;
  }

  .kpi-value {
    color: theme('colors.text.000');
    font-size: 1.1875rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.15;
  }

  .kpi-progress {
    height: 0.25rem;
    margin-top: 0.125rem;
    overflow: hidden;
    border-radius: 999px;
    background: theme('colors.border.300');
  }

  .kpi-progress span {
    display: block;
    height: 100%;
    background: theme('colors.accent-main.100');
  }

  .kpi-note {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.375rem;
    color: theme('colors.text.300');
    font-size: 0.75rem;
  }

  .is-positive {
    color: theme('colors.positive');
  }

  @media (min-width: 480px) {
    .kpi-value {
      font-size: 1.5rem;
    }
  }

  @media (min-width: 900px) {
    .kpi {
      padding: 1rem 1.25rem;
    }

    .kpi:nth-child(n + 3) {
      border-top: 0;
    }

    .kpi + .kpi {
      border-left: 1px solid theme('colors.border.300');
    }

    .kpi-value {
      font-size: 1.625rem;
    }
  }
</style>
