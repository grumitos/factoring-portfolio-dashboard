---
interface Props {
  title: string;
  value: string;
  trend?: string;
  trendClass?: string;
  fullWidth?: boolean;
  class?: string;
}

const { title, value, trend = '', trendClass = 'positive', fullWidth = false, class: customClassFromProp } = Astro.props;
---

<div class:list={["summary-card", customClassFromProp, { "full-width": fullWidth }]}>
  <div class="summary-info">
    <h3 class="text-sm font-medium text-text-300">{title}</h3>
    <p class="summary-value text-xl font-semibold">{value}</p>
    {trend && (
      <p class={`summary-trend ${trendClass}`}>{trend}</p>
    )}
  </div>
</div>

<style>
  .summary-card {
    background-color: theme('colors.bg.000');
    border: 0.5px solid theme('colors.border.300');
    border-radius: 1rem;
    padding: theme('spacing.standard');
    transition: all 0.2s ease;
    box-shadow: 0 0.25rem 1.25rem rgb(0 0 0 / 7%);
  }

  .summary-card:hover {
    border-color: theme('colors.border.200');
    box-shadow: 0 0.25rem 1.25rem rgb(0 0 0 / 15%);
  }

  .full-width {
    grid-column: 1 / -1;
  }

  .summary-info {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .summary-value {
    margin: 0.5rem 0;
    font-weight: 600;
  }

  .summary-trend {
    font-size: 0.875rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .positive {
    color: theme('colors.accent-main.000');
  }

  .negative {
    color: #ef4444;
  }
</style>
