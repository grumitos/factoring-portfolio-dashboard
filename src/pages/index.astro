---
import Layout from '../layouts/Layout.astro';
import SvgSprite from '../components/SvgSprite.astro';
import SummaryCard from '../components/SummaryCard.astro';
import ChartContainer from '../components/ChartContainer.astro';
import FactoringCard from '../components/FactoringCard.astro';
import { getReportMetrics, getInjectionTrendLabel, getTimeToGoalWithInjection } from '../lib/dataService';

const goal = 300_000;
const injection = 5700;
// obtener datos async
const { report, progressPct } = await getReportMetrics(goal);
const { months } = getTimeToGoalWithInjection(report, goal, injection);
const trendLabelInjection = getInjectionTrendLabel(months);
---

<Layout title="Proyección de Inversiones">	<main class="main-content mx-auto w-full">		<div class="dashboard-content">
			<div class="grid grid-cols-2 gap-standard mb-standard">
				<SummaryCard
					class="summary-soles-card"
					title="Total en Soles"
					value={new Intl.NumberFormat('es-PE', { style: 'currency', currency: 'PEN' }).format(report.netPen)}
					trend={`En el mes: S/ ${report.gainRealLastMonth.toFixed(2)}`}
				/>
				<SummaryCard
					class="summary-dolares-card"
					title="Total en Dólares"
					value={`$ ${report.netUsd.toLocaleString('es-PE', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`}
					trend={`En el mes: $ ${report.gainRealLastMonthUsd.toFixed(2)}`}
				/>
				<SummaryCard
					class="summary-tasa-card"
					title="Tasa Promedio"
					value={`${report.annualRatePct.toFixed(2)}%`}
					trend="Anualizada"
				/>
				<SummaryCard
					class="summary-goal-card"
					title={`Meta: S/ ${new Intl.NumberFormat('es-PE', { notation: 'compact', compactDisplay: 'long' }).format(goal)}`}
					value={`${progressPct.toFixed(2)}%`}
					trend={`${trendLabelInjection}`}
				/>
			</div>

                        <ChartContainer report={report} injection={injection} />
			<FactoringCard report={report} />
		</div>
	</main>
	<SvgSprite />
</Layout>

<style>	.main-content { max-width: 1200px; }
	.dashboard-content { padding: 0; }
	/* Removing the bottom margin for the last component to avoid extra space */
	.dashboard-content > :last-child {
		margin-bottom: 0;
	}
</style>
