# Copia este archivo como .env y completa tus valores.
# Montos sin separador de miles: 25000, no 25,000.

# Clave de Currency Freaks para el tipo de cambio USD/PEN en vivo (opcional; sin ella se usa 3.70).
CURRENCY_FREAKS_API_KEY=

# Capital que mantienes fuera de la plataforma, en cada moneda.
EXTERNAL_CAPITAL_PEN=0
EXTERNAL_CAPITAL_USD=0

# Aporte mensual y meta del patrimonio total, en soles.
MONTHLY_INJECTION_PEN=1000
GOAL_PEN=100000
